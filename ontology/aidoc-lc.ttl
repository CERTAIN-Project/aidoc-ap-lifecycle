@prefix : <https://w3id.org/aidoc-ap/lifecycle#> .
@prefix aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#> .
@prefix aidoc: <https://w3id.org/aidoc-ap#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dpv-ai: <https://w3id.org/dpv/ai#> .
@prefix dpv-tech: <https://w3id.org/dpv/tech#> .
@prefix dpv-aiact: <https://w3id.org/dpv/legal/eu/aiact#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix vair: <https://w3id.org/vair#> .
@base <https://w3id.org/aidoc-ap/lifecycle#> .

# AIDOC-AP Lifecycle Extension (aidoc-lc)

<https://w3id.org/aidoc-ap/lifecycle#> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/aidoc-ap/1.2> ;
    owl:versionIRI <https://w3id.org/aidoc-ap/lifecycle/0.1> ;
    owl:versionInfo "0.1" ;
    dcterms:title "AIDOC-AP Lifecycle Extension"@en ;
    rdfs:label "AIDOC-AP Lifecycle Extension"@en ;
    dcterms:description "Extension module of the AIDOC-AP application profile. It adds the terms needed to describe the stages of the AI system lifecycle that the AIDOC-AP core, which is restricted to the documentation duties of Annex IV of the EU AI Act, does not cover in detail: links from lifecycle activities to the artefacts they use and produce, and stage-specific descriptions. The module imports the core and does not change any core definition."@en ;
    dcterms:creator [ rdf:type foaf:Person ;
                      foaf:name "Sebastian Neumaier" ;
                      foaf:mbox <mailto:sebastian.neumaier@ustp.at> ;
                      foaf:organization "University of Applied Sciences St. Pölten" ] ;
    # dcterms:contributor: add the contributors according to their roles before the first release
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher [ foaf:name "CERTAIN Project" ;
                        foaf:homepage <https://certain-project.eu> ] ;
    dcterms:language "en" ;
    vann:preferredNamespacePrefix "aidoc-lc" ;
    vann:preferredNamespaceUri "https://w3id.org/aidoc-ap/lifecycle#" ;
    schema:funding <https://cordis.europa.eu/project/id/101189650> ;
    skos:note "Draft, not released."@en .

#################################################################
#    Classes
#################################################################


#################################################################
#    Object properties
#################################################################

###  https://w3id.org/aidoc-ap/lifecycle#evaluates
:evaluates rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:ModelEvaluation aidoc:PostMarketPerformanceEvaluationActivity ) ] ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( aidoc:AIModel aidoc:AISystem ) ] ;
    rdfs:label "evaluates"@en ;
    rdfs:comment "Relates an evaluation activity, before release or after deployment, to the AI model or AI system whose performance it assesses."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC 22989:2022, AI system life cycle: verification and validation, re-evaluation" .

###  https://w3id.org/aidoc-ap/lifecycle#hasHyperParameterSetting
:hasHyperParameterSetting rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:ModelEngineering aidoc:DataWrangling aidoc:DataProcessing ) ] ;
    rdfs:range mls:HyperParameterSetting ;
    rdfs:label "has hyperparameter setting"@en ;
    rdfs:comment "Relates a model engineering or data preparation activity to a hyperparameter setting that was fixed before the activity ran, such as a learning rate, an optimiser, an outlier threshold or a maximum sequence length."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(b)" ;
    skos:example "The experiment that trained an XGBoost load forecaster has the settings learning_rate = 0.05 and max_depth = 6."@en .

###  https://w3id.org/aidoc-ap/lifecycle#packagesModel
:packagesModel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:ModelPackaging ;
    rdfs:range aidoc:AIModel ;
    rdfs:label "packages model"@en ;
    rdfs:comment "Relates a model packaging activity to the trained AI model that it prepares for deployment."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#packagingFormat
:packagingFormat rdf:type owl:ObjectProperty ;
    rdfs:domain aidoc:ModelPackaging ;
    rdfs:range skos:Concept ;
    rdfs:label "packaging format"@en ;
    rdfs:comment "Relates a model packaging activity to the format in which it stores the model for deployment, such as an MLflow model, ONNX or a container image. Values are concepts, for example from the scheme aidoc-lc:PackagingFormats."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#producesMeasurement
:producesMeasurement rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:ExplorationAndValidation aidoc:DataProcessing aidoc:ModelEvaluation aidoc:PostMarketMonitoringActivity aidoc:PostMarketPerformanceEvaluationActivity ) ] ;
    rdfs:range dqv:QualityMeasurement ;
    rdfs:label "produces measurement"@en ;
    rdfs:comment "Relates an activity that profiles, evaluates or monitors data or models to a quality measurement it computes, such as a missing-value rate, a test accuracy or a drift score."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    skos:example "A model evaluation activity produces a measurement of the metric RMSE with the value 812.4, computed on the trained model."@en .

###  https://w3id.org/aidoc-ap/lifecycle#producesModel
:producesModel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain aidoc:ModelEngineering ;
    rdfs:range aidoc:AIModel ;
    rdfs:label "produces model"@en ;
    rdfs:comment "Relates a model engineering activity to an AI model or model checkpoint that it trains."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(a)" .

###  https://w3id.org/aidoc-ap/lifecycle#usesComputationalResource
:usesComputationalResource rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:AIActivity ;
    rdfs:range aidoc:ComputationalResource ;
    rdfs:label "uses computational resource"@en ;
    rdfs:comment "Relates a lifecycle activity to a computational resource it runs on, such as a GPU, a cluster node or a serving instance."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(c)" .


#################################################################
#    Datatype properties
#################################################################


#################################################################
#    Individuals (concept schemes for categorical values)
#################################################################

###  https://w3id.org/aidoc-ap/lifecycle#PackagingFormats
:PackagingFormats rdf:type skos:ConceptScheme ;
    skos:prefLabel "Packaging formats"@en ;
    skos:definition "Seed list of formats in which a trained model is stored for deployment. Values from other schemes may be used with aidoc-lc:packagingFormat."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#ContainerImageFormat
:ContainerImageFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "Container image"@en ;
    skos:definition "A container image that bundles the model with its runtime and dependencies, following the Open Container Initiative image specification."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://github.com/opencontainers/image-spec> .

###  https://w3id.org/aidoc-ap/lifecycle#MLflowModelFormat
:MLflowModelFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "MLflow Model"@en ;
    skos:definition "The MLflow directory format that stores a model together with its flavours, environment specification and signature."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://mlflow.org/docs/latest/models.html> .

###  https://w3id.org/aidoc-ap/lifecycle#ONNXFormat
:ONNXFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "ONNX"@en ;
    skos:definition "The Open Neural Network Exchange format, which represents a model as a computation graph of standard operators."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://onnx.ai/> .

###  https://w3id.org/aidoc-ap/lifecycle#PickleFormat
:PickleFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "Pickle or joblib file"@en ;
    skos:definition "A Python object serialisation of a model, as written by pickle or joblib."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://docs.python.org/3/library/pickle.html> .

###  https://w3id.org/aidoc-ap/lifecycle#SavedModelFormat
:SavedModelFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "TensorFlow SavedModel"@en ;
    skos:definition "The TensorFlow format that stores the graph, weights and signatures of a model."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://www.tensorflow.org/guide/saved_model> .

###  https://w3id.org/aidoc-ap/lifecycle#TorchScriptFormat
:TorchScriptFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "TorchScript"@en ;
    skos:definition "A serialised PyTorch program that can be loaded and run without a Python interpreter."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://pytorch.org/docs/stable/jit.html> .
