@prefix : <https://w3id.org/aidoc-ap/lifecycle#> .
@prefix aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#> .
@prefix aidoc: <https://w3id.org/aidoc-ap#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dpv-ai: <https://w3id.org/dpv/ai#> .
@prefix dpv-tech: <https://w3id.org/dpv/tech#> .
@prefix dpv-aiact: <https://w3id.org/dpv/legal/eu/aiact#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix vair: <https://w3id.org/vair#> .
@base <https://w3id.org/aidoc-ap/lifecycle#> .

# AIDOC-AP Lifecycle Extension (aidoc-lc)

<https://w3id.org/aidoc-ap/lifecycle#> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/aidoc-ap/1.2> ;
    owl:versionIRI <https://w3id.org/aidoc-ap/lifecycle/1.0> ;
    owl:versionInfo "1.0" ;
    dcterms:title "AIDOC-AP Lifecycle Extension"@en ;
    rdfs:label "AIDOC-AP Lifecycle Extension"@en ;
    dcterms:description "Extension module of the AIDOC-AP application profile. It adds the terms needed to describe the stages of the AI system lifecycle that the AIDOC-AP core, which is restricted to the documentation duties of Annex IV of the EU AI Act, does not cover in detail: links from lifecycle activities to the artefacts they use and produce, and stage-specific descriptions. The module imports the core and does not change any core definition."@en ;
    dcterms:creator [ rdf:type foaf:Person ;
                      foaf:name "Sebastian Neumaier" ;
                      foaf:mbox <mailto:sebastian.neumaier@ustp.at> ;
                      foaf:organization "University of Applied Sciences St. Pölten" ] ,
                    [ rdf:type foaf:Person ;
                      foaf:name "Tobias Dam" ;
                      foaf:organization "University of Applied Sciences St. Pölten" ] ,
                    [ rdf:type foaf:Person ;
                      foaf:name "Fabian Kovac" ;
                      foaf:organization "University of Applied Sciences St. Pölten" ] ;
    dcterms:created "2026-10-02"^^xsd:date ;
    dcterms:modified "2026-10-06"^^xsd:date ;
    dcterms:issued "2026-10-06"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher [ foaf:name "CERTAIN Project" ;
                        foaf:homepage <https://certain-project.eu> ] ;
    dcterms:language "en" ;
    vann:preferredNamespacePrefix "aidoc-lc" ;
    vann:preferredNamespaceUri "https://w3id.org/aidoc-ap/lifecycle#" ;
    schema:funding <https://cordis.europa.eu/project/id/101189650> .

#################################################################
#    Classes
#################################################################


###  https://w3id.org/aidoc-ap/lifecycle#DataAugmentation
:DataAugmentation rdf:type owl:Class ;
    rdfs:subClassOf aidoc:DataProcessing ;
    rdfs:label "Data Augmentation"@en ;
    rdfs:comment "Data preparation activity that adds synthetic or transformed records to a dataset, for example by injecting noise, resampling or applying label-preserving transformations, in order to enlarge or balance the training data."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "Studer et al., Towards CRISP-ML(Q): A Machine Learning Process Model with Quality Assurance Methodology, arXiv:2003.05155, data preparation phase" ;
    skos:example "Adding Gaussian noise to the load measurements of an energy time series before training."@en .

###  https://w3id.org/aidoc-ap/lifecycle#Tokenization
:Tokenization rdf:type owl:Class ;
    rdfs:subClassOf aidoc:DataProcessing ;
    rdfs:label "Tokenization"@en ;
    rdfs:comment "Data preparation activity that splits text into tokens and encodes them for a language model according to a tokenizer configuration. Tokenizer settings are recorded as hyperparameter settings and the resulting statistics as quality measurements."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

#################################################################
#    Object properties
#################################################################


###  https://w3id.org/aidoc-ap/lifecycle#assignsRegistryStage
:assignsRegistryStage rdf:type owl:ObjectProperty ;
    rdfs:domain aidoc:ModelVersioning ;
    rdfs:range skos:Concept ;
    rdfs:label "assigns registry stage"@en ;
    rdfs:comment "Relates a model versioning activity to the stage it assigns to the model version in a model registry, such as staging, production or archived. Values are concepts, for example from the scheme aidoc-lc:RegistryStages."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#buildStatus
:buildStatus rdf:type owl:ObjectProperty ;
    rdfs:domain aidoc:BuildAndIntegrationTesting ;
    rdfs:range skos:Concept ;
    rdfs:label "build status"@en ;
    rdfs:comment "Relates a build and integration testing activity to the outcome of its build, such as succeeded or failed. Values are concepts, for example from the scheme aidoc-lc:BuildStatuses."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#decommissions
:decommissions rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:invalidated ;
    rdfs:domain aidoc:Decommissioning ;
    rdfs:range [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:AIModel aidoc:AISystem ) ] ;
    rdfs:label "decommissions"@en ;
    rdfs:comment "Relates a decommissioning activity to the AI model or AI system that it takes out of operation."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC 22989:2022, AI system life cycle: retirement" .

###  https://w3id.org/aidoc-ap/lifecycle#deploys
:deploys rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:Deployment ;
    rdfs:range [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:AIModel aidoc:AISystem ) ] ;
    rdfs:label "deploys"@en ;
    rdfs:comment "Relates a deployment activity to the AI model or AI system that it installs and makes available in a target environment."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#evaluates
:evaluates rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:ModelEvaluation aidoc:PostMarketPerformanceEvaluationActivity ) ] ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( aidoc:AIModel aidoc:AISystem ) ] ;
    rdfs:label "evaluates"@en ;
    rdfs:comment "Relates an evaluation activity, before release or after deployment, to the AI model or AI system whose performance it assesses."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC 22989:2022, AI system life cycle: verification and validation, re-evaluation" .

###  https://w3id.org/aidoc-ap/lifecycle#hasHyperParameterSetting
:hasHyperParameterSetting rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:ModelEngineering aidoc:DataWrangling aidoc:DataProcessing ) ] ;
    rdfs:range mls:HyperParameterSetting ;
    rdfs:label "has hyperparameter setting"@en ;
    rdfs:comment "Relates a model engineering or data preparation activity to a hyperparameter setting that was fixed before the activity ran, such as a learning rate, an optimiser, an outlier threshold or a maximum sequence length."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(b)" ;
    skos:example "The experiment that trained an XGBoost load forecaster has the settings learning_rate = 0.05 and max_depth = 6."@en .

###  https://w3id.org/aidoc-ap/lifecycle#monitors
:monitors rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:PostMarketMonitoringActivity ;
    rdfs:range [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:AIModel aidoc:AISystem ) ] ;
    rdfs:label "monitors"@en ;
    rdfs:comment "Relates a post-market monitoring activity to the deployed AI model or AI system whose behaviour it observes."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Article 72" .

###  https://w3id.org/aidoc-ap/lifecycle#packagesModel
:packagesModel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:ModelPackaging ;
    rdfs:range aidoc:AIModel ;
    rdfs:label "packages model"@en ;
    rdfs:comment "Relates a model packaging activity to the trained AI model that it prepares for deployment."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#packagingFormat
:packagingFormat rdf:type owl:ObjectProperty ;
    rdfs:domain aidoc:ModelPackaging ;
    rdfs:range skos:Concept ;
    rdfs:label "packaging format"@en ;
    rdfs:comment "Relates a model packaging activity to the format in which it stores the model for deployment, such as an MLflow model, ONNX or a container image. Values are concepts, for example from the scheme aidoc-lc:PackagingFormats."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#producesChangeRecord
:producesChangeRecord rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain aidoc:AIActivity ;
    rdfs:range aidoc:ChangeRecord ;
    rdfs:label "produces change record"@en ;
    rdfs:comment "Relates a lifecycle activity to the change record that documents the change it made to the AI system or its components."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(6)" .

###  https://w3id.org/aidoc-ap/lifecycle#producesMeasurement
:producesMeasurement rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:ExplorationAndValidation aidoc:DataProcessing aidoc:ModelEvaluation aidoc:PostMarketMonitoringActivity aidoc:PostMarketPerformanceEvaluationActivity ) ] ;
    rdfs:range dqv:QualityMeasurement ;
    rdfs:label "produces measurement"@en ;
    rdfs:comment "Relates an activity that profiles, evaluates or monitors data or models to a quality measurement it computes, such as a missing-value rate, a test accuracy or a drift score."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    skos:example "A model evaluation activity produces a measurement of the metric RMSE with the value 812.4, computed on the trained model."@en .

###  https://w3id.org/aidoc-ap/lifecycle#producesModel
:producesModel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain aidoc:ModelEngineering ;
    rdfs:range aidoc:AIModel ;
    rdfs:label "produces model"@en ;
    rdfs:comment "Relates a model engineering activity to an AI model or model checkpoint that it trains."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(a)" .

###  https://w3id.org/aidoc-ap/lifecycle#producesSoftware
:producesSoftware rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain aidoc:SoftwareDevelopment ;
    rdfs:range [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:SoftwareImplementation aidoc:SoftwareComponent ) ] ;
    rdfs:label "produces software"@en ;
    rdfs:comment "Relates a software development activity to the software implementation or software component that it writes or changes."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(a)" .

###  https://w3id.org/aidoc-ap/lifecycle#producesTestReport
:producesTestReport rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:BuildAndIntegrationTesting aidoc:ModelEvaluation ) ] ;
    rdfs:range dpv-aiact:TestReport ;
    rdfs:label "produces test report"@en ;
    rdfs:comment "Relates a testing or evaluation activity to the test report that summarises the tests it ran and their results."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(g)" .

###  https://w3id.org/aidoc-ap/lifecycle#testLevel
:testLevel rdf:type owl:ObjectProperty ;
    rdfs:domain aidoc:BuildAndIntegrationTesting ;
    rdfs:range skos:Concept ;
    rdfs:label "test level"@en ;
    rdfs:comment "Relates a build and integration testing activity to the level of the tests it runs, such as component, integration, system or acceptance testing. Values are concepts, for example from the scheme aidoc-lc:TestLevels."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC/IEEE 29119-1, test levels" .

###  https://w3id.org/aidoc-ap/lifecycle#testsArtifact
:testsArtifact rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:BuildAndIntegrationTesting ;
    rdfs:range aidoc:AIArtifact ;
    rdfs:label "tests artifact"@en ;
    rdfs:comment "Relates a build and integration testing activity to the artefact it builds and tests, such as a packaged model or a software component."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#usesComputationalResource
:usesComputationalResource rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:AIActivity ;
    rdfs:range aidoc:ComputationalResource ;
    rdfs:label "uses computational resource"@en ;
    rdfs:comment "Relates a lifecycle activity to a computational resource it runs on, such as a GPU, a cluster node or a serving instance."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(2)(c)" .

###  https://w3id.org/aidoc-ap/lifecycle#versionsModel
:versionsModel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:ModelVersioning ;
    rdfs:range aidoc:AIModel ;
    rdfs:label "versions model"@en ;
    rdfs:comment "Relates a model versioning activity to the AI model version that it registers or whose status it changes."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(1)(c)" .

###  https://w3id.org/aidoc-ap/lifecycle#versionsSoftware
:versionsSoftware rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain aidoc:SoftwareVersioning ;
    rdfs:range [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:SoftwareImplementation aidoc:SoftwareComponent ) ] ;
    rdfs:label "versions software"@en ;
    rdfs:comment "Relates a software versioning activity to the software implementation or component revision that it records, for example a commit in a version control system."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(1)(c)" .

#################################################################
#    Datatype properties
#################################################################


###  https://w3id.org/aidoc-ap/lifecycle#decommissioningAction
:decommissioningAction rdf:type owl:DatatypeProperty ;
    rdfs:domain aidoc:Decommissioning ;
    rdfs:range xsd:string ;
    rdfs:label "decommissioning action"@en ;
    rdfs:comment "A step carried out as part of a decommissioning activity, such as disabling an endpoint or archiving model weights."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    skos:example "archive model weights to cold storage"@en .

###  https://w3id.org/aidoc-ap/lifecycle#decommissioningReason
:decommissioningReason rdf:type owl:DatatypeProperty ;
    rdfs:domain aidoc:Decommissioning ;
    rdfs:range xsd:string ;
    rdfs:label "decommissioning reason"@en ;
    rdfs:comment "The reason why a model or system is taken out of operation, for example its replacement by a retrained version."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    skos:example "Replaced by a retrained model with lower error on the current holdout set."@en .

###  https://w3id.org/aidoc-ap/lifecycle#processingTechnique
:processingTechnique rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( aidoc:DataWrangling aidoc:DataProcessing ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "processing technique"@en ;
    rdfs:comment "The name of the technique that a data wrangling or data preparation activity applies, such as outlier removal by interquartile range or min-max scaling."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Article 10(2)(c) and Annex IV(2)(d)" ;
    skos:example "remove_outliers_iqr"@en .

###  https://w3id.org/aidoc-ap/lifecycle#servingEndpoint
:servingEndpoint rdf:type owl:DatatypeProperty ;
    rdfs:domain aidoc:Deployment ;
    rdfs:range xsd:anyURI ;
    rdfs:label "serving endpoint"@en ;
    rdfs:comment "The network address at which a deployment serves predictions of the deployed model or system."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "EU AI Act 2024/1689, Annex IV(1)(d)" ;
    skos:example "https://models.example.org/energy-load/v1/predict" .

#################################################################
#    Individuals (concept schemes for categorical values)
#################################################################


###  https://w3id.org/aidoc-ap/lifecycle#PackagingFormats
:PackagingFormats rdf:type skos:ConceptScheme ;
    skos:prefLabel "Packaging formats"@en ;
    skos:definition "Seed list of formats in which a trained model is stored for deployment. Values from other schemes may be used with aidoc-lc:packagingFormat."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#ContainerImageFormat
:ContainerImageFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "Container image"@en ;
    skos:definition "A container image that bundles the model with its runtime and dependencies, following the Open Container Initiative image specification."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://github.com/opencontainers/image-spec> .

###  https://w3id.org/aidoc-ap/lifecycle#MLflowModelFormat
:MLflowModelFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "MLflow Model"@en ;
    skos:definition "The MLflow directory format that stores a model together with its flavours, environment specification and signature."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://mlflow.org/docs/latest/models.html> .

###  https://w3id.org/aidoc-ap/lifecycle#ONNXFormat
:ONNXFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "ONNX"@en ;
    skos:definition "The Open Neural Network Exchange format, which represents a model as a computation graph of standard operators."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://onnx.ai/> .

###  https://w3id.org/aidoc-ap/lifecycle#PickleFormat
:PickleFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "Pickle or joblib file"@en ;
    skos:definition "A Python object serialisation of a model, as written by pickle or joblib."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://docs.python.org/3/library/pickle.html> .

###  https://w3id.org/aidoc-ap/lifecycle#SavedModelFormat
:SavedModelFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "TensorFlow SavedModel"@en ;
    skos:definition "The TensorFlow format that stores the graph, weights and signatures of a model."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://www.tensorflow.org/guide/saved_model> .

###  https://w3id.org/aidoc-ap/lifecycle#TorchScriptFormat
:TorchScriptFormat rdf:type skos:Concept ;
    skos:inScheme :PackagingFormats ;
    skos:topConceptOf :PackagingFormats ;
    skos:prefLabel "TorchScript"@en ;
    skos:definition "A serialised PyTorch program that can be loaded and run without a Python interpreter."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://pytorch.org/docs/stable/jit.html> .

###  https://w3id.org/aidoc-ap/lifecycle#RegistryStages
:RegistryStages rdf:type skos:ConceptScheme ;
    skos:prefLabel "Registry stages"@en ;
    skos:definition "Seed list of the stages a model version can hold in a model registry, taken from the MLflow Model Registry. MLflow 2.9 deprecated stages in favour of aliases; values from other schemes may be used with aidoc-lc:assignsRegistryStage."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#RegistryStaging
:RegistryStaging rdf:type skos:Concept ;
    skos:inScheme :RegistryStages ;
    skos:topConceptOf :RegistryStages ;
    skos:prefLabel "Staging"@en ;
    skos:definition "The registry stage of a model version that is being prepared and tested for production use."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://mlflow.org/docs/latest/model-registry.html> .

###  https://w3id.org/aidoc-ap/lifecycle#RegistryProduction
:RegistryProduction rdf:type skos:Concept ;
    skos:inScheme :RegistryStages ;
    skos:topConceptOf :RegistryStages ;
    skos:prefLabel "Production"@en ;
    skos:definition "The registry stage of a model version that serves the production system."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://mlflow.org/docs/latest/model-registry.html> .

###  https://w3id.org/aidoc-ap/lifecycle#RegistryArchived
:RegistryArchived rdf:type skos:Concept ;
    skos:inScheme :RegistryStages ;
    skos:topConceptOf :RegistryStages ;
    skos:prefLabel "Archived"@en ;
    skos:definition "The registry stage of a model version that is kept for reference but no longer served."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source <https://mlflow.org/docs/latest/model-registry.html> .

###  https://w3id.org/aidoc-ap/lifecycle#BuildStatuses
:BuildStatuses rdf:type skos:ConceptScheme ;
    skos:prefLabel "Build statuses"@en ;
    skos:definition "Seed list of outcomes of a build, after the conclusion values of common continuous integration services. Values from other schemes may be used with aidoc-lc:buildStatus."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#BuildSucceeded
:BuildSucceeded rdf:type skos:Concept ;
    skos:inScheme :BuildStatuses ;
    skos:topConceptOf :BuildStatuses ;
    skos:prefLabel "Succeeded"@en ;
    skos:definition "The build completed and produced its artefacts."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#BuildFailed
:BuildFailed rdf:type skos:Concept ;
    skos:inScheme :BuildStatuses ;
    skos:topConceptOf :BuildStatuses ;
    skos:prefLabel "Failed"@en ;
    skos:definition "The build stopped with an error and produced no usable artefact."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#BuildCancelled
:BuildCancelled rdf:type skos:Concept ;
    skos:inScheme :BuildStatuses ;
    skos:topConceptOf :BuildStatuses ;
    skos:prefLabel "Cancelled"@en ;
    skos:definition "The build was stopped before it completed."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#TestLevels
:TestLevels rdf:type skos:ConceptScheme ;
    skos:prefLabel "Test levels"@en ;
    skos:definition "Seed list of test levels after ISO/IEC/IEEE 29119-1. Values from other schemes may be used with aidoc-lc:testLevel."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> .

###  https://w3id.org/aidoc-ap/lifecycle#ComponentTestLevel
:ComponentTestLevel rdf:type skos:Concept ;
    skos:inScheme :TestLevels ;
    skos:topConceptOf :TestLevels ;
    skos:prefLabel "Component testing"@en ;
    skos:definition "Testing of a single software component or unit in isolation."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC/IEEE 29119-1, test levels" .

###  https://w3id.org/aidoc-ap/lifecycle#IntegrationTestLevel
:IntegrationTestLevel rdf:type skos:Concept ;
    skos:inScheme :TestLevels ;
    skos:topConceptOf :TestLevels ;
    skos:prefLabel "Integration testing"@en ;
    skos:definition "Testing of the interfaces and interactions between integrated components, for example between a packaged model and its serving layer."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC/IEEE 29119-1, test levels" .

###  https://w3id.org/aidoc-ap/lifecycle#SystemTestLevel
:SystemTestLevel rdf:type skos:Concept ;
    skos:inScheme :TestLevels ;
    skos:topConceptOf :TestLevels ;
    skos:prefLabel "System testing"@en ;
    skos:definition "Testing of the complete, integrated AI system against its requirements."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC/IEEE 29119-1, test levels" .

###  https://w3id.org/aidoc-ap/lifecycle#AcceptanceTestLevel
:AcceptanceTestLevel rdf:type skos:Concept ;
    skos:inScheme :TestLevels ;
    skos:topConceptOf :TestLevels ;
    skos:prefLabel "Acceptance testing"@en ;
    skos:definition "Testing that decides whether the AI system meets the needs of its users or deployers before it is put into service."@en ;
    rdfs:isDefinedBy <https://w3id.org/aidoc-ap/lifecycle#> ;
    dcterms:source "ISO/IEC/IEEE 29119-1, test levels" .
