    {"id": "D2", "phase": "D", "label": "Exploration and validation",
     "classes": ["https://w3id.org/aidoc-ap#ExplorationAndValidation"],
     "sources": [{"ref": "MLOPS-E2E", "term": "Exploration and Validation"}]},
    {"id": "D3", "phase": "D", "label": "Data wrangling (cleaning)",
     "classes": ["https://w3id.org/aidoc-ap#DataWrangling", "https://w3id.org/aidoc-ap#DataCleaningProcedure"],
     "sources": [{"ref": "MLOPS-E2E", "term": "Data Wrangling (Cleaning)"}]},
    {"id": "D4", "phase": "D", "label": "Data labelling",
