    {"id": "S3", "phase": "S", "label": "Deployment and model serving",
     "classes": ["https://w3id.org/aidoc-ap#Deployment"],
     "sources": [{"ref": "MLOPS-E2E", "term": "Model Serving"}, {"ref": "ISO-22989", "term": "dpv-ai:DeploymentStage"}]},
    {"id": "S4", "phase": "S", "label": "Software versioning and change management",
     "classes": ["https://w3id.org/aidoc-ap#SoftwareVersioning"],
     "sources": [{"ref": "AI-ACT", "term": "Annex IV 1(c); Annex IV 6"}, {"ref": "ISO-22989", "term": "dpv-ai:UpdateStage"}]},
    {"id": "O1", "phase": "O", "label": "Performance monitoring and logging",
     "classes": ["https://w3id.org/aidoc-ap#DataMonitoringAndLogging"],
     "sources": [{"ref": "MLOPS-E2E", "term": "Model Performance Monitoring; Model Performance Logging"}, {"ref": "ISO-22989", "term": "dpv-ai:OperationStage"}, {"ref": "AI-ACT", "term": "Art. 12"}]},
    {"id": "O2", "phase": "O", "label": "Post-market monitoring",
     "classes": ["https://w3id.org/aidoc-ap#PostMarketMonitoringActivity"],
     "sources": [{"ref": "AI-ACT", "term": "Art. 72"}]},
    {"id": "O3", "phase": "O", "label": "Re-evaluation",
     "classes": ["https://w3id.org/aidoc-ap#PostMarketPerformanceEvaluationActivity"],
     "sources": [{"ref": "ISO-22989", "term": "dpv-ai:ReevaluationStage"}]},
    {"id": "O4", "phase": "O", "label": "Retirement and decommissioning",
     "classes": ["https://w3id.org/aidoc-ap#Decommissioning"],
     "sources": [{"ref": "ISO-22989", "term": "dpv-ai:RetirementStage; dpv-ai:DecommissionStage"}]}
  ],
  "not_included": [
    {"stage": "Inception and design (ISO/IEC 22989)", "reason": "Annex IV records purpose and design choices as properties of the system and of model engineering, not as a separate activity."},
    {"stage": "Continuous validation (ISO/IEC 22989)", "reason": "Treated as part of O1 and O3."},
    {"stage": "Data augmentation", "reason": "Not a stage in the cited MLOps sources; part of data preparation (D5), as in CRISP-ML(Q)."}
  ]
}
