  "target": {"oci_min": 0.90, "no_stage_at_zero": true},
  "sources": {
    "MLOPS-E2E": "Visengeriyeva, Kammer, Baer, Kniesz, Ploed: End-to-end Machine Learning Workflow. ml-ops.org, https://ml-ops.org/content/end-to-end-ml-workflow",
    "MLOPS-3L": "Visengeriyeva, Kammer, Baer, Kniesz, Ploed: Three Levels of ML Software. ml-ops.org, https://ml-ops.org/content/three-levels-of-ml-software",
    "CRISP-ML(Q)": "Studer et al.: Towards CRISP-ML(Q): A Machine Learning Process Model with Quality Assurance Methodology. Machine Learning and Knowledge Extraction 3(2), 2021 [verify citation details]",
    "ISO-22989": "ISO/IEC 22989:2022, AI system life cycle stages, as represented in DPV-AI (dpv-ai:*Stage concepts carry dct:source 'ISO/IEC 22989:2022')",
    "AI-ACT": "Regulation (EU) 2024/1689 (AI Act): Art. 12 record-keeping, Art. 72 post-market monitoring, Annex IV point 1(c) software versions, Annex IV point 6 changes through the lifecycle"
  },
  "phases": [
    {"id": "D", "label": "Data pipeline"},
    {"id": "M", "label": "ML pipeline"},
    {"id": "S", "label": "Code pipeline"},
    {"id": "O", "label": "Operation"}
