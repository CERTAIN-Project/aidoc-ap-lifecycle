# Rule: decommissioning decommissions the model of its deployment (O4); dcterms:date becomes the end time.
# Reason and actions are not in the engine output and cannot be lifted.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?d aidoc-lc:decommissions ?m .
  ?d prov:endedAtTime ?t .
}
WHERE {
  ?d a aidoc:Decommissioning ; prov:wasInfluencedBy ?dep .
  ?dep a aidoc:Deployment ; prov:used ?m .
  OPTIONAL { ?d dcterms:date ?t }
}
