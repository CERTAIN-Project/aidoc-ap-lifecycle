# Rule: packaging packages the model of its deployment and has a packaging format concept (M3).
# Engine: packaging prov:wasInfluencedBy deployment; dcterms:format packaging_format.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?p aidoc-lc:packagesModel ?m .
  ?p aidoc-lc:packagingFormat ?concept .
}
WHERE {
  ?p a aidoc:ModelPackaging ; prov:wasInfluencedBy ?dep .
  ?dep a aidoc:Deployment ; prov:used ?m .
  OPTIONAL {
    ?p dcterms:format ?f .
    VALUES (?name ?concept) {
      ("mlflow_model" aidoc-lc:MLflowModelFormat) ("mlflow" aidoc-lc:MLflowModelFormat) ("onnx" aidoc-lc:ONNXFormat)
      ("torchscript" aidoc-lc:TorchScriptFormat) ("savedmodel" aidoc-lc:SavedModelFormat) ("tf_savedmodel" aidoc-lc:SavedModelFormat)
      ("pickle" aidoc-lc:PickleFormat) ("joblib" aidoc-lc:PickleFormat) ("docker" aidoc-lc:ContainerImageFormat)
      ("container_image" aidoc-lc:ContainerImageFormat)
    }
    FILTER (LCASE(STR(?f)) = ?name)
  }
}
