# Rule: the evaluation activity evaluates its model and produces the measurements of the evaluation stages.
# Engine: evaluation prov:used model; metric rows with aidoc:dataScope 'evaluation', 'validation' or 'test'.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?ev aidoc-lc:evaluates ?m .
  ?ev aidoc-lc:producesMeasurement ?x .
  ?metric a aidoc:PerformanceMetric .
}
WHERE {
  ?ev a aidoc:ModelEvaluation ; prov:used ?m .
  OPTIONAL {
    ?x dqv:computedOn ?m ; aidoc:dataScope ?scope ; rdfs:label ?k .
    FILTER (LCASE(STR(?scope)) IN ("evaluation", "validation", "test", "testing"))
    BIND (IRI(CONCAT("https://w3id.org/aidoc-ap/metrics/", ENCODE_FOR_URI(STR(?k)))) AS ?metric)
  }
}
