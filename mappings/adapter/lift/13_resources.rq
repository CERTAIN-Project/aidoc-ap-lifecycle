# Rule: activities use the computational resources logged for them; hardware provides resources.
# Engine: resource prov:wasUsedBy model (undeclared); resource aidoc:requiresHardware hardware (domain conflict).
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?run aidoc-lc:usesComputationalResource ?r .
  ?h aidoc:providesComputationalResource ?r .
}
WHERE {
  ?r a aidoc:ComputationalResource .
  OPTIONAL { ?r prov:wasUsedBy ?m . ?m a aidoc:AIModel ; prov:wasGeneratedBy ?run . }
  OPTIONAL { ?r aidoc:requiresHardware ?h . }
}
