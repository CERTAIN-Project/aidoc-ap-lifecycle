# Rule: deployment terms (S3) and the version of the deployed model.
# Engine: deployment prov:used model; schema:url endpoint; aidoc:version on the activity.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?dep aidoc-lc:deploys ?m .
  ?dep aidoc-lc:servingEndpoint ?endpoint .
  ?m aidoc:version ?v .
  ?dep aidoc-lc:usesComputationalResource ?runtime .
}
WHERE {
  ?dep a aidoc:Deployment ; prov:used ?m .
  OPTIONAL { ?dep schema:url ?u . BIND (STRDT(STR(?u), xsd:anyURI) AS ?endpoint) }
  OPTIONAL { ?dep aidoc:version ?v }
  OPTIONAL { ?runtime prov:wasUsedBy ?dep ; a aidoc:ComputationalResource }
}
