# Rule: build and integration testing tests the model of its deployment (S2).
# Build status, test type and test results are not in the engine output and cannot be lifted.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT { ?t aidoc-lc:testsArtifact ?m . }
WHERE {
  ?t a aidoc:BuildAndIntegrationTesting ; prov:wasInfluencedBy ?dep .
  ?dep a aidoc:Deployment ; prov:used ?m .
}
