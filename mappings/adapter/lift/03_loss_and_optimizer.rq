# Rule: loss function and optimizer (undeclared mls:hasObjective, mls:hasOptimizer) become settings.
# The value is the last IRI segment; percent-encoded characters stay encoded.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?s a mls:HyperParameterSetting ; mls:specifiedBy ?hp ; mls:hasValue ?v .
  ?hp a mls:HyperParameter ; rdfs:label ?key .
  ?exp aidoc-lc:hasHyperParameterSetting ?s .
  ?run a mls:Run ; mls:hasInput ?s .
}
WHERE {
  { ?m mls:hasObjective ?o . BIND ("loss_function" AS ?key) BIND (STRAFTER(STR(?o), "/objectives/") AS ?v) }
  UNION
  { ?m mls:hasOptimizer ?o . BIND ("optimizer" AS ?key) BIND (STRAFTER(STR(?o), "/optimizers/") AS ?v) }
  ?m prov:wasGeneratedBy ?run .
  ?run prov:wasInfluencedBy ?exp .
  ?exp a aidoc:ModelEngineering .
  BIND (IRI(CONCAT(STR(?m), "/hyperparameter/", ?key)) AS ?s)
  BIND (IRI(CONCAT("https://w3id.org/aidoc-ap/hyperparameters/", ?key)) AS ?hp)
}
