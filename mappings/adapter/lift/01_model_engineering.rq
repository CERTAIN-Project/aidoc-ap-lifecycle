# Rule: the experiment of a run produces the models and checkpoints of that run (producesModel, D-15).
# Engine: model prov:wasGeneratedBy run; run prov:wasInfluencedBy experiment.
PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX airo: <https://w3id.org/airo#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT { ?exp aidoc-lc:producesModel ?m . ?exp aidoc-lc:producesModel ?c . }
WHERE {
  ?m a aidoc:AIModel ; prov:wasGeneratedBy ?run .
  ?run prov:wasInfluencedBy ?exp .
  ?exp a aidoc:ModelEngineering .
  OPTIONAL { ?c a aidoc:AIModel ; prov:wasDerivedFrom ?m . }
}
