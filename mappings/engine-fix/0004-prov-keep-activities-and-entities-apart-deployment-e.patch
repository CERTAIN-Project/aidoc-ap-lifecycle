From 413242e1f46a3b2d464dfc46875ac4740f9ad2bc Mon Sep 17 00:00:00 2001
From: Sebastian Neumaier <seb.neumaier@gmail.com>
Date: Tue, 6 Oct 2026 08:52:32 +0200
Subject: [PATCH 4/5] prov: keep activities and entities apart (deployment,
 examples, change log and records, lifecycle phase)

---
 ontop/input/aidoc-ap_r2rml.ttl | 39 +++++++++++-----------------------
 1 file changed, 12 insertions(+), 27 deletions(-)

diff --git a/ontop/input/aidoc-ap_r2rml.ttl b/ontop/input/aidoc-ap_r2rml.ttl
index 9d2dad5..535b2fb 100644
--- a/ontop/input/aidoc-ap_r2rml.ttl
+++ b/ontop/input/aidoc-ap_r2rml.ttl
@@ -963,9 +963,9 @@
         rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ]
     ] ;
 
-    # Link to model
+    # Link to model (prov:wasGeneratedBy needs an activity; a model is an entity)
     rr:predicateObjectMap [
-        rr:predicate prov:wasGeneratedBy ;
+        rr:predicate prov:wasDerivedFrom ;
         rr:objectMap [
             rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
             rr:termType rr:IRI
@@ -1320,15 +1320,6 @@
             rr:template "https://w3id.org/aidoc-ap/data/{run_id}/{data_id}" ;
             rr:termType rr:IRI
         ]
-    ] ;
-
-    # Link run to deployment
-    rr:predicateObjectMap [
-        rr:predicate prov:generated ;
-        rr:objectMap [
-            rr:template "https://w3id.org/aidoc-ap/deployments/{experiment_id}/{model_id}/{deployment_id}" ;
-            rr:termType rr:IRI
-        ]
     ] .
 
 
@@ -2569,7 +2560,6 @@
     rr:subjectMap [
         rr:template "https://w3id.org/aidoc-ap/changelog/{run_id}" ;
         rr:class aidoc:ChangeLog ;
-        rr:class prov:Activity ;
     ] ;
 
     rr:predicateObjectMap [
@@ -2603,7 +2593,7 @@
     rr:logicalTable [
         rr:sqlQuery """
             SELECT run_id, log_id, change_description, changed_by,
-                   to_timestamp(CASE WHEN change_timestamp > 10000000000 THEN change_timestamp / 1000.0 ELSE change_timestamp END) AS change_ts
+                   to_char(to_timestamp(CASE WHEN change_timestamp > 10000000000 THEN change_timestamp / 1000.0 ELSE change_timestamp END), 'YYYY-MM-DD') AS change_date
             FROM change_logs
         """
     ] ;
@@ -2623,14 +2613,19 @@
         rr:objectMap [ rr:column "change_description" ; rr:datatype xsd:string ]
     ] ;
 
+    # A change record is an entity: attributed to its author, dated with aidoc:endDate
+    # (prov:wasAssociatedWith and prov:endedAtTime apply to activities)
     rr:predicateObjectMap [
-        rr:predicate prov:wasAssociatedWith ;
-        rr:objectMap [ rr:column "changed_by" ; rr:datatype xsd:string ]
+        rr:predicate prov:wasAttributedTo ;
+        rr:objectMap [
+            rr:template "https://w3id.org/aidoc-ap/users/{changed_by}" ;
+            rr:termType rr:IRI
+        ]
     ] ;
 
     rr:predicateObjectMap [
-        rr:predicate prov:endedAtTime ;
-        rr:objectMap [ rr:column "change_ts" ; rr:datatype xsd:dateTime ]
+        rr:predicate aidoc:endDate ;
+        rr:objectMap [ rr:column "change_date" ; rr:datatype xsd:date ]
     ] .
 
 
@@ -2782,16 +2777,6 @@
         rr:objectMap [ rr:column "description" ; rr:datatype xsd:string ]
     ] ;
 
-    rr:predicateObjectMap [
-        rr:predicate prov:startedAtTime ;
-        rr:objectMap [ rr:column "creation_ts" ; rr:datatype xsd:dateTime ]
-    ] ;
-
-    rr:predicateObjectMap [
-        rr:predicate prov:endedAtTime ;
-        rr:objectMap [ rr:column "last_update_ts" ; rr:datatype xsd:dateTime ]
-    ] ;
-
     # Link to experiment
     rr:predicateObjectMap [
         rr:predicate prov:wasInfluencedBy ;
-- 
