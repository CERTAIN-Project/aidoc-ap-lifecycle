+# =============================================================================
+# Versions on the versioned entities (aidoc:version has the domain prov:Entity)
+# =============================================================================
+
+<#ModelVersionTriplesMap>
+    a rr:TriplesMap ;
+
+    rr:logicalTable [
+        rr:sqlQuery """
+            SELECT DISTINCT run_id, model_id, model_version
+            FROM model_deployed
+            WHERE model_version IS NOT NULL
+        """
+    ] ;
+
+    rr:subjectMap [
+        rr:template "https://w3id.org/aidoc-ap/models/{run_id}/{model_id}" ;
+    ] ;
+
+    rr:predicateObjectMap [
+        rr:predicate aidoc:version ;
+        rr:objectMap [ rr:column "model_version" ; rr:datatype xsd:string ]
+    ] .
+
+<#RunCodeVersionTriplesMap>
+    a rr:TriplesMap ;
+
+    rr:logicalTable [
+        rr:sqlQuery """
+            SELECT run_id, source_version
+            FROM runs
+            WHERE source_version IS NOT NULL AND source_version <> ''
+        """
+    ] ;
+
+    rr:subjectMap [
+        rr:template "https://w3id.org/aidoc-ap/runs/{run_id}/code" ;
+    ] ;
+
+    rr:predicateObjectMap [
+        rr:predicate aidoc:version ;
+        rr:objectMap [ rr:column "source_version" ; rr:datatype xsd:string ]
+    ] .
