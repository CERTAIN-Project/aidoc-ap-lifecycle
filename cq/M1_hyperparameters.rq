# CQ: Which hyperparameter settings, including optimiser and loss function, were used to train model M?
# Stage: M1
# Terms: aidoc-lc:hasHyperParameterSetting, aidoc-lc:producesModel

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?model ?engineering ?parameter ?value WHERE {
  ?engineering a aidoc:ModelEngineering ;
               aidoc-lc:producesModel ?model ;
               aidoc-lc:hasHyperParameterSetting ?setting .
  ?setting mls:specifiedBy ?hyperparameter ;
           mls:hasValue ?value .
  ?hyperparameter rdfs:label ?parameter .
}
ORDER BY ?model ?parameter
