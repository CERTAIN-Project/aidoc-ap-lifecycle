# CQ: Which changes were made to the AI system, by which activities, by whom and when?
# Stage: S4
# Terms: aidoc-lc:producesChangeRecord

PREFIX aidoc: <https://w3id.org/aidoc-ap#>
PREFIX aidoc-lc: <https://w3id.org/aidoc-ap/lifecycle#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?record ?activity ?activityType ?description ?reason ?author ?date WHERE {
  ?activity aidoc-lc:producesChangeRecord ?record .
  OPTIONAL {
    ?activity a ?activityType .
    FILTER (?activityType != aidoc:AIActivity && STRSTARTS(STR(?activityType), STR(aidoc:)))
  }
  OPTIONAL { ?record dcterms:description ?description }
  OPTIONAL { ?record aidoc:reasonForChange ?reason }
  OPTIONAL { ?record prov:wasAttributedTo ?author }
  OPTIONAL { ?record aidoc:endDate ?date }
}
ORDER BY ?date
